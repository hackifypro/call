# ============================================================================
# AURA INDIA — COMPANION BOOKING PLATFORM ENVIRONMENT CONFIGURATION
# ============================================================================

# NEXT.JS ENVIRONMENT
NEXT_PUBLIC_APP_URL=https://aura-india.com
NEXT_PUBLIC_PLATFORM_NAME="Aura India"
NEXT_PUBLIC_DEFAULT_COMMISSION_RATE=10

# SUPABASE / POSTGRESQL DATABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# PAYMENT GATEWAY (RAZORPAY / CASHFREE / ESCROW)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PRIVATE IDENTITY STORAGE (S3 / SUPABASE PRIVATE BUCKET)
PRIVATE_STORAGE_BUCKET=companion-private-kyc
PRIVATE_STORAGE_SECRET=your-private-storage-secret

# NOTIFICATIONS & OTP PROVIDER (FAST2SMS / TWILIO)
SMS_PROVIDER_API_KEY=your_sms_gateway_key
SUPPORT_HELPLINE_NUMBER="+91 1800-209-AURA"
SUPPORT_EMAIL=trust@aura-india.com
